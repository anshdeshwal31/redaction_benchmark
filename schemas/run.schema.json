{
 "$defs": {
  "ExperimentSpec": {
   "additionalProperties": false,
   "properties": {
    "schema": {
     "const": "rb.experiment/0.1",
     "default": "rb.experiment/0.1",
     "title": "Schema",
     "type": "string"
    },
    "name": {
     "pattern": "^[a-z0-9][a-z0-9_-]*$",
     "title": "Name",
     "type": "string"
    },
    "mode": {
     "default": "e2e",
     "enum": [
      "e2e",
      "oracle_text",
      "oracle_mentions",
      "oracle_entities",
      "oracle_regions"
     ],
     "title": "Mode",
     "type": "string"
    },
    "repeats": {
     "default": 1,
     "maximum": 50,
     "minimum": 1,
     "title": "Repeats",
     "type": "integer"
    },
    "vary_seed": {
     "default": false,
     "description": "Pass a different seed to each repeat (seed sensitivity)",
     "title": "Vary Seed",
     "type": "boolean"
    },
    "inject_from": {
     "default": "gt",
     "description": "Source of injected stage inputs: \"gt\", or \"run:<run_id>\" to inject another candidate's artifacts (stage swapping)",
     "title": "Inject From",
     "type": "string"
    },
    "description": {
     "default": "",
     "title": "Description",
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "title": "ExperimentSpec",
   "type": "object"
  },
  "RunItem": {
   "additionalProperties": false,
   "properties": {
    "doc_id": {
     "title": "Doc Id",
     "type": "string"
    },
    "repeat": {
     "title": "Repeat",
     "type": "integer"
    },
    "workdir": {
     "title": "Workdir",
     "type": "string"
    },
    "input_sha256": {
     "title": "Input Sha256",
     "type": "string"
    },
    "injected": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Injected",
     "type": "object"
    },
    "seed": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Seed"
    },
    "exit_code": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Exit Code"
    },
    "timed_out": {
     "default": false,
     "title": "Timed Out",
     "type": "boolean"
    },
    "duration_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Duration S"
    },
    "artifacts": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Artifacts",
     "type": "object"
    },
    "invalid_artifacts": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Invalid Artifacts",
     "type": "object"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Error"
    }
   },
   "required": [
    "doc_id",
    "repeat",
    "workdir",
    "input_sha256"
   ],
   "title": "RunItem",
   "type": "object"
  },
  "RunPolicy": {
   "additionalProperties": false,
   "description": "The policy file a run was made with. It reaches the tool only through ``{policy}`` in the\ntool's command or through oracle inputs built under it; when it did, scoring warns if it scores\nby another policy.",
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "version": {
     "title": "Version",
     "type": "string"
    },
    "sha256": {
     "description": "SHA-256 of the policy file's bytes",
     "pattern": "^[0-9a-f]{64}$",
     "title": "Sha256",
     "type": "string"
    },
    "path": {
     "description": "Absolute path of the policy file when the run was made",
     "title": "Path",
     "type": "string"
    },
    "given_to_tool": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Whether the tool received this policy: its command passes {policy}, or the experiment injected mentions, entities or regions built from GT under it. Absent in runs recorded before it was kept; scoring then works it out from the recorded command and experiment",
     "title": "Given To Tool"
    }
   },
   "required": [
    "name",
    "version",
    "sha256",
    "path"
   ],
   "title": "RunPolicy",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "rb.run/0.1",
   "default": "rb.run/0.1",
   "title": "Schema",
   "type": "string"
  },
  "run_id": {
   "title": "Run Id",
   "type": "string"
  },
  "created": {
   "title": "Created",
   "type": "string"
  },
  "benchmark": {
   "additionalProperties": true,
   "title": "Benchmark",
   "type": "object"
  },
  "dataset": {
   "additionalProperties": true,
   "title": "Dataset",
   "type": "object"
  },
  "candidate": {
   "additionalProperties": true,
   "title": "Candidate",
   "type": "object"
  },
  "experiment": {
   "$ref": "#/$defs/ExperimentSpec"
  },
  "environment": {
   "additionalProperties": true,
   "title": "Environment",
   "type": "object"
  },
  "policy": {
   "anyOf": [
    {
     "$ref": "#/$defs/RunPolicy"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Absent in runs made before the run's policy was recorded"
  },
  "items": {
   "default": [],
   "items": {
    "$ref": "#/$defs/RunItem"
   },
   "title": "Items",
   "type": "array"
  }
 },
 "required": [
  "run_id",
  "created",
  "benchmark",
  "dataset",
  "candidate",
  "experiment",
  "environment"
 ],
 "title": "RunManifest",
 "type": "object"
}
