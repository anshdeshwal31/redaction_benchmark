{
 "$defs": {
  "ModelInfo": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Version"
    },
    "extra": {
     "additionalProperties": {
      "type": "string"
     },
     "default": {},
     "title": "Extra",
     "type": "object"
    }
   },
   "required": [
    "name"
   ],
   "title": "ModelInfo",
   "type": "object"
  },
  "ReleaseInfo": {
   "additionalProperties": false,
   "description": "The tool's own safety verdict. Tools always hand over their output; this records whether\nthey would have released it, so the benchmark can grade the safety check itself (false\nalarms, unsafe releases).",
   "properties": {
    "released": {
     "title": "Released",
     "type": "boolean"
    },
    "checks_failed": {
     "default": [],
     "description": "The tool's own reason codes for holding the document back",
     "items": {
      "type": "string"
     },
     "title": "Checks Failed",
     "type": "array"
    }
   },
   "required": [
    "released"
   ],
   "title": "ReleaseInfo",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "rb.runinfo/0.1",
   "default": "rb.runinfo/0.1",
   "title": "Schema",
   "type": "string"
  },
  "candidate": {
   "title": "Candidate",
   "type": "string"
  },
  "candidate_version": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Candidate Version"
  },
  "config": {
   "additionalProperties": true,
   "default": {},
   "title": "Config",
   "type": "object"
  },
  "seed": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Seed"
  },
  "models": {
   "default": [],
   "items": {
    "$ref": "#/$defs/ModelInfo"
   },
   "title": "Models",
   "type": "array"
  },
  "started_at": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Started At"
  },
  "finished_at": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Finished At"
  },
  "notes": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Notes"
  },
  "release": {
   "anyOf": [
    {
     "$ref": "#/$defs/ReleaseInfo"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  }
 },
 "required": [
  "candidate"
 ],
 "title": "RunInfo",
 "type": "object"
}
