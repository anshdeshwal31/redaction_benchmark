   "default": "rb.gt/0.1",
   "title": "Schema",
   "type": "string"
  },
  "doc_id": {
   "minLength": 1,
   "title": "Doc Id",
   "type": "string"
  },
  "source_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "title": "Source Sha256",
   "type": "string"
  },
  "gt_version": {
   "title": "Gt Version",
   "type": "string"
  },
  "matter": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Matter"
  },
  "pages": {
   "items": {
    "$ref": "#/$defs/GTPage"
   },
   "title": "Pages",
   "type": "array"
  },
  "mentions": {
   "default": [],
   "items": {
    "$ref": "#/$defs/GTMention"
   },
   "title": "Mentions",
   "type": "array"
  },
  "entities": {
   "default": [],
   "items": {
    "$ref": "#/$defs/GTEntity"
   },
   "title": "Entities",
   "type": "array"
  },
  "relations": {
   "default": [],
