    "$ref": "#/$defs/GTRelation"
   },
   "title": "Relations",
   "type": "array"
  },
  "classified": {
   "default": [],
   "items": {
    "$ref": "#/$defs/GTClassified"
   },
   "title": "Classified",
   "type": "array"
  },
  "surface": {
   "default": [],
   "items": {
    "$ref": "#/$defs/SurfaceItem"
   },
   "title": "Surface",
   "type": "array"
  },
  "annotators": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Annotators",
   "type": "array"
  },
  "notes": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Notes"
  }
 },
 "required": [
  "doc_id",
  "source_sha256",
  "gt_version",
  "pages"
 ],
 "title": "GTDocument",
 "type": "object"
}
